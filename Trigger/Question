1. Write a trigger to stop a user from deleting an Account if it has related Contacts.

                      trigger AccountTrigger on Account (before delete) {
                          Set<Id> accountIds = Trigger.oldMap.keySet();
                          Map<Id, Account> accountsWithContacts = new Map<Id, Account>([SELECT Id FROM Account WHERE Id IN :accountIds AND Id IN (SELECT AccountId FROM Contact)]);
                          for (Account acc : Trigger.old) {
                              if (accountsWithContacts.containsKey(acc.Id)) {
                                  acc.addError('You cannot delete this Account because it has related Contacts. Please delete or re-parent the Contacts first.');
                              }
                          }
                      }
                      


